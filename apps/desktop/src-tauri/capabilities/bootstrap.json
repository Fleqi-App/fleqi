{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bootstrap",
  "description": "M3 控制台、设置、输入条与能力调用窗口：只允许白名单内的宿主命令与事件监听。窗口由宿主创建，页面不能自报角色。",
  "local": true,
  "windows": [
    "console",
    "settings",
    "composer"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-scale-factor",
    "allow-app-build-info",
    "allow-app-bootstrap",
    "allow-diagnostics-get",
    "allow-app-open-window",
    "allow-app-quit",
    "allow-settings-update",
    "allow-permissions-get",
    "allow-permissions-check",
    "allow-permissions-request",
    "allow-permissions-open-settings",
    "allow-context-get",
    "allow-context-refresh",
    "allow-context-pick-directory",
    "allow-surface-show",
    "allow-surface-hide",
    "allow-surface-get",
    "allow-surface-layout",
    "allow-session-create",
    "allow-session-list",
    "allow-session-entries",
    "allow-session-select",
    "allow-session-end",
    "allow-session-end-all",
    "allow-session-delete",
    "allow-session-pin",
    "allow-session-continue",
    "allow-terminal-open",
    "allow-terminal-snapshot",
    "allow-terminal-input",
    "allow-terminal-acquire-lease",
    "allow-terminal-resize",
    "allow-terminal-ack",
    "allow-terminal-submit-line",
    "allow-terminal-cancel-queued",
    "allow-terminal-withdrawn-line",
    "allow-terminal-subscribe",
    "allow-terminal-unsubscribe",
    "allow-terminal-release-lease",
    "allow-hotkey-commit",
    "allow-hotkey-clear",
    "allow-hotkey-get",
    "allow-run-submit",
    "allow-run-approve",
    "allow-run-cancel",
    "allow-run-get",
    "allow-run-plan-get",
    "allow-run-list",
    "allow-run-retry",
    "allow-rules-create",
    "allow-rules-list",
    "allow-rules-update",
    "allow-rules-delete",
    "allow-favorites-create",
    "allow-favorites-list",
    "allow-favorites-update",
    "allow-favorites-delete",
    "allow-history-append",
    "allow-history-list",
    "allow-history-clear",
    "allow-provider-probe",
    "allow-catalog-query",
    "allow-capability-form",
    "allow-capability-submit",
    "allow-tools-list",
    "allow-tools-install",
    "allow-tools-install-status",
    "allow-tools-install-cancel",
    "allow-tools-remove",
    "allow-provider-save",
    "allow-provider-list",
    "allow-provider-delete",
    "allow-run-plan-submit",
    "allow-run-plan-cancel",
    "allow-tools-prepare",
    "allow-tools-prepare-status",
    "allow-tools-prepare-cancel",
    "allow-app-update-status",
    "allow-app-update-check",
    "allow-app-update-install"
  ]
}
