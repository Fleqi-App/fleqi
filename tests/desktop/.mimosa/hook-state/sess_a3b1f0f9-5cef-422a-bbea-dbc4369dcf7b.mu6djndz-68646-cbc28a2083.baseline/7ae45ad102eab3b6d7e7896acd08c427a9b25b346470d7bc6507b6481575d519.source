{
  "name": "fleqi-desktop-test",
  "version": "0.0.1-beta.1",
  "private": true,
  "type": "module",
  "description": "macOS 原生验收驱动（WebdriverIO embedded）：驱动 --features desktop-test 的测试构建，真实 WKWebView + 真实只读 IPC，留截图与启动/退出证据。",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.3",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.4.0",
    "typescript": "5.9.3",
    "webdriverio": "9.31.9"
  }
}
